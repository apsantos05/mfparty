# Configure na Vercel. Nunca comite a chave real.
BRAVOPAY_API_KEY=bp_live_sua_chave_aqui

# Opcionais para UTMify/produto real
BRAVOPAY_PRODUCT_ID_MULHER=
BRAVOPAY_PRODUCT_ID_HOMEM=

# Gerado pela BravoPay ao cadastrar a URL do webhook em Dashboard → Integrações
BRAVOPAY_WEBHOOK_SECRET=whsec_seu_secret_aqui

# Obrigatório para assinar/verificar referências de pedidos sem banco. Gere 32+ caracteres aleatórios.
ORDER_SIGNING_SECRET=cole_aqui_um_segredo_aleatorio_de_32_ou_mais_caracteres

# Recomendado para carga alta: cache de confirmação via webhook e limites compartilhados por minuto.
# Crie um banco Redis REST compatível e configure ambos em Production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: produto dedicado ao Combo Amigo
BRAVOPAY_PRODUCT_ID_COMBO=

# Opcional: produto dedicado ao ingresso +16 sem álcool
BRAVOPAY_PRODUCT_ID_JOVEM=

# Obrigatório para a portaria: escolha uma senha exclusiva com no mínimo 16 caracteres.
# Configure como Secret apenas no ambiente Production da Vercel. Nunca publique a senha.
GATE_PASSWORD=

# Opcional: segredo exclusivo para emissão de ingressos (32+ caracteres).
# Se vazio, uma chave específica é derivada de ORDER_SIGNING_SECRET.
TICKET_SIGNING_SECRET=

# Prazo de validação dos ingressos, independente dos 7 dias antigos do PIX.
TICKET_VALID_UNTIL=2026-11-02T12:00:00-03:00
